{{ 'section-header.css' | asset_url | stylesheet_tag }}

<header class="site-header" data-section-id="{{ section.id }}" data-section-type="header">
  <div class="site-header__inner page-width">

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 300 | image_tag:
            widths: '150,200,300',
            alt: section.settings.logo.alt | default: shop.name,
            class: 'site-header__logo-image'
          }}
        {%- else -%}
          <span class="site-header__wordmark">
            <span class="site-header__wordmark-word">{{ section.settings.logo_text_1 | default: 'Notions' }}</span>
            <span class="site-header__wordmark-word">{{ section.settings.logo_text_2 | default: 'in Pattern' }}</span>
          </span>
        {%- endif -%}
      </a>
    </div>

    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__nav-list">
        {%- for link in section.settings.main_menu.links -%}
          <li class="site-header__nav-item">
            <a href="{{ link.url }}" class="site-header__nav-link">
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      <a href="{{ routes.search_url }}" class="site-header__icon-link" aria-label="Search">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.3"/>
          <line x1="13.7" y1="14" x2="18" y2="18.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span class="site-header__icon-label">Search</span>
      </a>

      <a href="{{ routes.account_url }}" class="site-header__icon-link" aria-label="Account">
        {{ 'icon-account.svg' | inline_asset_content }}
        <span class="site-header__icon-label">Account</span>
      </a>

      <a href="{{ routes.cart_url }}" class="site-header__icon-link site-header__cart-link" aria-label="Cart">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span class="site-header__icon-label">Cart ({{ cart.item_count }})</span>
      </a>
    </div>

    <button type="button" class="site-header__mobile-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="site-header__mobile-nav" hidden>
    <ul>
      {%- for link in section.settings.main_menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</header>

<script>
  (function () {
    var toggle = document.querySelector('.site-header__mobile-toggle');
    var nav = document.querySelector('.site-header__mobile-nav');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      nav.hidden = isOpen;
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image (optional, overrides text logo)"
    },
    {
      "type": "text",
      "id": "logo_text_1",
      "label": "Wordmark line 1",
      "default": "Notions"
    },
    {
      "type": "text",
      "id": "logo_text_2",
      "label": "Wordmark line 2",
      "default": "in Pattern"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
